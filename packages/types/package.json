{
  "name": "@brain-storm/types",
  "version": "1.0.0",
  "description": "Shared TypeScript types for Brain-Storm",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./test-utils": {
      "import": "./src/test-utils/index.ts",
      "require": "./src/test-utils/index.ts",
      "types": "./src/test-utils/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "types",
    "typescript"
  ],
  "author": "Brain-Storm",
  "license": "MIT",
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "typescript": "^5.4.0"
  }
}
